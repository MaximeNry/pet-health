# PostgreSQL
DB_USER=pethealth
DB_PASSWORD=pethealth_dev
DB_NAME=pethealth
DB_PORT=5432

# Prisma — the "postgres" host = the Docker service name
DATABASE_URL=postgresql://pethealth:pethealth_dev@postgres:5432/pethealth

# Auth — Google OAuth (create an OAuth client in the Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Signing secret for the app session (JWT)
JWT_SECRET=dev-secret-change-me
# Where to redirect the browser after login
FRONTEND_URL=http://localhost:3001