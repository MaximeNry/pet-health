# PostgreSQL
DB_USER=pethealth
DB_PASSWORD=pethealth_dev
DB_NAME=pethealth
DB_PORT=5432

# Prisma — le host "postgres" = le nom du service Docker
DATABASE_URL=postgresql://pethealth:pethealth_dev@postgres:5432/pethealth

# Auth — Google OAuth (créer un client OAuth dans Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Secret de signature de la session applicative (JWT)
JWT_SECRET=dev-secret-change-me
# Où rediriger le navigateur après login
FRONTEND_URL=http://localhost:3001