// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Species {
  DOG
  CAT
  RABBIT
  BIRD
  OTHER
}

enum Sex {
  MALE
  FEMALE
}

model Pet {
  id          String   @id @default(uuid())
  name        String
  species     Species
  breed       String?
  sex         Sex?
  weightKg    Float?   @map("weight_kg")
  birthDate   DateTime @map("birth_date")
  householdId String   @map("household_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([householdId])
  @@map("pets")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  // Google `sub`: stable identity for Google login. Nullable so the dormant
  // local-auth path stays possible; unique so it keys find-or-create.
  googleId     String?  @unique @map("google_id")
  // Nullable: Google users have no password (local argon2 path is dormant).
  passwordHash String?  @map("password_hash")
  // Google OAuth refresh token (granted with the drive.file scope) used by the
  // health-document context to upload files to the user's Drive. Null until
  // the user goes through a login that returns one.
  googleRefreshToken String? @map("google_refresh_token")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  invitationsSent     Invitation[] @relation("InvitationsSent")
  invitationsAccepted Invitation[] @relation("InvitationsAccepted")

  @@map("users")
}

enum DocumentType {
  VACCINATION
  PRESCRIPTION
  LAB_RESULT
  CERTIFICATE
  IDENTIFICATION
  SURGERY
  OTHER
}

model HealthDocument {
  id           String       @id @default(uuid())
  petId        String       @map("pet_id")
  householdId  String       @map("household_id")
  driveFileId  String       @map("drive_file_id")
  // Member whose Google Drive holds the file: downloads/deletions always go
  // through this user's tokens, whoever in the household asks.
  uploaderUserId String     @map("uploader_user_id")
  documentType DocumentType @map("document_type")
  title        String
  documentDate DateTime     @map("document_date")
  tags         String[]     @default([])
  mimeType     String       @map("mime_type")
  sizeBytes    Int          @map("size_bytes")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([petId])
  @@index([householdId])
  @@map("health_documents")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

model Household {
  id            String            @id @default(uuid())
  name          String
  // Free-form document categories owned by the household. The column default
  // also backfills pre-existing rows when the migration runs.
  documentTypes String[]          @default(["Vaccination", "Prescription", "Lab result", "Certificate"]) @map("document_types")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  members       HouseholdMember[]
  invitations   Invitation[]

  @@map("households")
}

model HouseholdMember {
  householdId String        @map("household_id")
  userId      String        @map("user_id")
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  household   Household     @relation(fields: [householdId], references: [id])

  @@id([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// Household invitation redeemed via a shareable link. No "EXPIRED" status on
// purpose: expiration is derived from `expiresAt < now()`; `status` only
// carries decided transitions (accepted, revoked). The raw invitation token is
// never stored — only its SHA-256 hash. A partial unique index (added by raw
// SQL in the migration, Prisma can't express it) guarantees at most one
// PENDING invitation per (household, email).
model Invitation {
  id           String           @id @default(uuid())
  householdId  String           @map("household_id")
  invitedEmail String           @map("invited_email")
  tokenHash    String           @unique @map("token_hash")
  status       InvitationStatus @default(PENDING)
  invitedBy    String           @map("invited_by")
  expiresAt    DateTime         @map("expires_at")
  acceptedBy   String?          @map("accepted_by")
  acceptedAt   DateTime?        @map("accepted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  // Cascade: deleting a user account must not be blocked by invitations they
  // sent; accepted-by simply loses the reference (default SetNull).
  inviter      User             @relation("InvitationsSent", fields: [invitedBy], references: [id], onDelete: Cascade)
  accepter     User?            @relation("InvitationsAccepted", fields: [acceptedBy], references: [id])

  @@index([householdId])
  @@map("invitations")
}
