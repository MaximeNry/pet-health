// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Species {
  DOG
  CAT
  RABBIT
  BIRD
  OTHER
}

enum Sex {
  MALE
  FEMALE
}

model Pet {
  id          String   @id @default(uuid())
  name        String
  species     Species
  breed       String?
  sex         Sex?
  weightKg    Float?   @map("weight_kg")
  birthDate   DateTime @map("birth_date")
  householdId String   @map("household_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([householdId])
  @@map("pets")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  // Google `sub`: stable identity for Google login. Nullable so the dormant
  // local-auth path stays possible; unique so it keys find-or-create.
  googleId     String?  @unique @map("google_id")
  // Nullable: Google users have no password (local argon2 path is dormant).
  passwordHash String?  @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum DocumentType {
  VACCINATION
  PRESCRIPTION
  LAB_RESULT
  CERTIFICATE
  OTHER
}

model HealthDocument {
  id           String       @id @default(uuid())
  petId        String       @map("pet_id")
  householdId  String       @map("household_id")
  driveFileId  String       @map("drive_file_id")
  documentType DocumentType @map("document_type")
  documentDate DateTime     @map("document_date")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([petId])
  @@index([householdId])
  @@map("health_documents")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

model Household {
  id            String            @id @default(uuid())
  name          String
  // Free-form document categories owned by the household. The column default
  // also backfills pre-existing rows when the migration runs.
  documentTypes String[]          @default(["Vaccination", "Prescription", "Lab result", "Certificate"]) @map("document_types")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  members       HouseholdMember[]

  @@map("households")
}

model HouseholdMember {
  householdId String        @map("household_id")
  userId      String        @map("user_id")
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  household   Household     @relation(fields: [householdId], references: [id])

  @@id([householdId, userId])
  @@index([userId])
  @@map("household_members")
}
