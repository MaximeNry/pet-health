FROM node:24-alpine

# Corepack ships with Node — enable pnpm through it
RUN corepack enable pnpm

WORKDIR /app

# ── Layer 1: workspace config (almost never changes) ───────────────
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./

# ── Layer 2: the package.json of every workspace package ───────────
# Copy ONLY the manifests, not the source code.
# pnpm needs every workspace package.json to resolve the dependency
# graph, even when a single app is being started.
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/

# ── Layer 3: dependency installation ───────────────────────────────
# --frozen-lockfile = pnpm fails if the lockfile is out of sync with
# the package.json files. That is what we want in Docker: reproducible
# builds, never a silently modified lockfile.
# This layer is only recomputed when a package.json or the lockfile
# changes → that is where the day-to-day build time is saved.
RUN pnpm install --frozen-lockfile

# ── Layer 4: the source code (changes on every edit) ───────────────
# In dev this layer is largely short-circuited by the docker-compose
# bind mounts (see below). It acts as a fallback when the container is
# started without mounts.
COPY . .

# ── Layer 5: Prisma client (gitignored, regenerated on every build) ─
# generate does not need a reachable database; a dummy URL is enough.
ENV DATABASE_URL=postgresql://pethealth:pethealth_dev@postgres:5432/pethealth
RUN pnpm --filter api exec prisma generate
